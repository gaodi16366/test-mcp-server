# Auth0 tenant domain (no https://)
AUTH0_DOMAIN=your-tenant.jp.auth0.com

# Must match the Auth0 API identifier.
# If Claude Desktop sends resource=<server URL> per RFC 8707, this must match that URL.
# Try your existing Auth0 API identifier first; change if Auth0 rejects with "unknown audience".
AUDIENCE=https://localhost/mcp

# This server's public URL (same as AUDIENCE for local testing)
SERVER_URL=http://localhost:3000

# Port to listen on
PORT=3000
